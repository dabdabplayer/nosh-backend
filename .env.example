# HTTP port used by the backend. Cloud platforms commonly provide this value.
PORT=3000

# Set to production when deployed. Never put credentials in this file.
NODE_ENV=development

# WhatsApp Cloud API webhook verification. Set both values in your deployment
# secret manager before configuring the callback URL in Meta's dashboard.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Gemini runs the agent: it decides which Swiggy tools to call and writes
# every free-form reply, in English. Without AGENT_API_KEY the bot only
# answers with a placeholder. Create the key in Google AI Studio, and turn
# on Cloud Billing for its project first: on the unpaid tier Google may use
# prompts and responses to improve its products, which Nosh's privacy policy
# and Swiggy's data terms don't allow.
AGENT_API_KEY=
# AGENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AGENT_MODEL=gemini-3.8-flash
# "minimal", "low", "medium" (the model's default) or "high". Higher is
# slower to reply.
# AGENT_REASONING_EFFORT=medium
# AGENT_TIMEOUT_MS=35000

# Sarvam AI translates Hindi/Hinglish messages to English for the agent and
# translates the agent's English replies back. Optional: without it the
# agent reads and answers in the user's raw language. Get a key from
# https://dashboard.sarvam.ai (shown only once, at creation).
NLU_API_KEY=
# NLU_BASE_URL defaults to https://api.sarvam.ai - give a bare origin; the
# sarvamai SDK appends the endpoint path itself.
# NLU_TIMEOUT_MS=15000

# Optional: report Swiggy / Gemini / Sarvam / WhatsApp health to an Atlassian
# Statuspage page. Create the API key under your Statuspage profile > API
# info (the page id is shown there too), and copy each component's id from
# its edit page in the dashboard. Any component id left unset isn't reported.
# STATUSPAGE_API_KEY=
# STATUSPAGE_PAGE_ID=
# STATUSPAGE_COMPONENT_SWIGGY=
# STATUSPAGE_COMPONENT_AGENT=
# STATUSPAGE_COMPONENT_TRANSLATION=
# STATUSPAGE_COMPONENT_WHATSAPP=

# Encrypts Swiggy OAuth tokens at rest (data/swiggy-tokens.json). Required -
# the app won't start without it. 32 random bytes, base64-encoded. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SWIGGY_TOKEN_ENCRYPTION_KEY=

# Optional: logs every inbound message and Nosh's reply to a Redis-
# compatible store (e.g. Render Key Value), so a reported issue can be
# debugged by replaying what actually happened - see src/conversation-log.js
# and scripts/view-chat-log.js. Both must be set together, or both left
# unset (chat logging is simply off). Each conversation's log auto-expires
# 14 days after the sender's last message (a Redis TTL, refreshed on every
# append - no cleanup job needed). Separate key from
# SWIGGY_TOKEN_ENCRYPTION_KEY on purpose - these protect different data.
# CHAT_LOG_REDIS_URL=
# CHAT_LOG_ENCRYPTION_KEY=

# Set to "1" to test the full WhatsApp conversation flow for real (real
# webhook, real replies) without ever contacting real Swiggy: skips per-
# sender OAuth entirely and routes every Food MCP call to an in-process mock
# (scripts/mock-swiggy-food-server.js) instead of SWIGGY_FOOD_MCP_URL.
# NEVER set this on a service carrying real user traffic - it treats every
# WhatsApp sender as already connected. Unset (the normal case) or any value
# other than "1"/"true" leaves real Swiggy OAuth/Food calls untouched; a
# stray value like "0" or "false" throws at boot rather than doing nothing.
# SWIGGY_TEST_MODE=1
