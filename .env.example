# HTTP port used by the backend. Cloud platforms commonly provide this value.
PORT=3000

# Set to production when deployed. Never put credentials in this file.
NODE_ENV=development

# WhatsApp Cloud API webhook verification. Set both values in your deployment
# secret manager before configuring the callback URL in Meta's dashboard.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# NVIDIA NIM API key for the AI/NLU layer. Get one at build.nvidia.com.
NVIDIA_API_KEY=

# Encrypts Swiggy OAuth tokens at rest in DynamoDB. Required - the app won't
# start without it. 32 random bytes, base64-encoded. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SWIGGY_TOKEN_ENCRYPTION_KEY=

# Name of the single shared DynamoDB table backing the Swiggy token store and
# every Pending* conversation-state store (see src/dynamo-item-store.js).
# Required - the app won't start without it. The table needs only a String
# partition key named "pk"; no sort key, no other attributes to configure.
DYNAMODB_TABLE_NAME=
