# HTTP port used by the backend. Cloud platforms commonly provide this value.
PORT=3000

# Set to production when deployed. Never put credentials in this file.
NODE_ENV=development

# WhatsApp Cloud API webhook verification. Set both values in your deployment
# secret manager before configuring the callback URL in Meta's dashboard.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Sarvam AI API key for the AI/NLU layer. Get one from the API Keys section
# of https://dashboard.sarvam.ai - the dashboard only ever shows it once, at
# creation time.
NLU_API_KEY=

# Optional overrides for the NLU layer's base URL/model - defaults to
# Sarvam's production API (https://api.sarvam.ai) with sarvam-105b.
# src/sarvam-agent.js's SarvamAIClient (the sarvamai npm SDK) accepts a
# custom baseUrl, so any compatible local server still works for local dev
# without burning Sarvam credits or hitting Sarvam's latency from a cloud
# network. IMPORTANT: give a bare origin here, never one ending in "/v1" -
# the SDK's ChatClient appends "v1/chat/completions" to this value itself
# (confirmed by reading node_modules/sarvamai/dist/cjs/api/resources/chat/
# client/Client.js and its own default in environments.js), so a baseUrl
# ending in "/v1" produces ".../v1/v1/chat/completions" and 404s - this bit
# production right after the sarvam-agent.js rollout (see config.js's
# DEFAULT_NLU_BASE_URL comment). The Ollama example below was only ever
# verified against the OLD nlu-client.js's plain fetch (which needed "/v1"
# baked in for a different reason); re-verify it live against the SDK
# (`ollama pull qwen2.5:7b`, then `ollama serve`) before trusting it -
# NLU_API_KEY above can stay set to anything, Ollama ignores the auth
# headers. Only valid for local dev - Render (or any other cloud host)
# can't reach a model running on your own machine's localhost.
# NLU_BASE_URL=http://localhost:11434
# NLU_MODEL=qwen2.5:7b

# How much reasoning effort the Sarvam agent uses per turn: "low", "medium",
# or "high". Defaults to "medium" (raised from "low" on 2026-09-21 - live
# testing showed "low" didn't reliably follow the system prompt's nuanced
# rules, e.g. language-mirroring, brevity). Higher settings add latency and
# eat further into Sarvam's 40 req/min rate limit for sarvam-105b on the
# Starter tier.
# NLU_REASONING_EFFORT=medium

# Encrypts Swiggy OAuth tokens at rest (data/swiggy-tokens.json). Required -
# the app won't start without it. 32 random bytes, base64-encoded. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SWIGGY_TOKEN_ENCRYPTION_KEY=

# Optional: logs every inbound message and Nosh's reply to a Redis-
# compatible store (e.g. Render Key Value), so a reported issue can be
# debugged by replaying what actually happened - see src/conversation-log.js
# and scripts/view-chat-log.js. Both must be set together, or both left
# unset (chat logging is simply off). Each conversation's log auto-expires
# 14 days after the sender's last message (a Redis TTL, refreshed on every
# append - no cleanup job needed). Separate key from
# SWIGGY_TOKEN_ENCRYPTION_KEY on purpose - these protect different data.
# CHAT_LOG_REDIS_URL=
# CHAT_LOG_ENCRYPTION_KEY=

# Set to "1" to test the full WhatsApp conversation flow for real (real
# webhook, real replies) without ever contacting real Swiggy: skips per-
# sender OAuth entirely and routes every Food MCP call to an in-process mock
# (scripts/mock-swiggy-food-server.js) instead of SWIGGY_FOOD_MCP_URL.
# NEVER set this on a service carrying real user traffic - it treats every
# WhatsApp sender as already connected. Unset (the normal case) or any value
# other than "1"/"true" leaves real Swiggy OAuth/Food calls untouched; a
# stray value like "0" or "false" throws at boot rather than doing nothing.
# SWIGGY_TEST_MODE=1
